@@ -3413,6 +3416,10 @@ static const RemminaProtocolSetting remmina_rdp_advanced_settings[] =
 	{ REMMINA_PROTOCOL_SETTING_TYPE_TEXT,	  "gateway_username",	    N_("Remote Desktop Gateway username"),		 FALSE, NULL,		  NULL														 },
 	{ REMMINA_PROTOCOL_SETTING_TYPE_PASSWORD, "gateway_password",	    N_("Remote Desktop Gateway password"),		 FALSE, NULL,		  NULL														 },
 	{ REMMINA_PROTOCOL_SETTING_TYPE_TEXT,	  "gateway_domain",	    N_("Remote Desktop Gateway domain"),		 FALSE, NULL,		  NULL														 },
+#ifdef WITH_RDP_AAD_HELPER
+	{ REMMINA_PROTOCOL_SETTING_TYPE_CHECK,	  "aad_external_browser",   N_("Entra ID sign-in in the system browser (passkeys)"),	 TRUE,	NULL,		  N_("Use FreeRDP's AAD auth helper and the system browser for the Entra ID sign-in instead of the embedded web view. Required for passkeys, FIDO2 security keys and phone passkeys at sign-in.")											 },
+	{ REMMINA_PROTOCOL_SETTING_TYPE_TEXT,	  "aad_browser",	    N_("Browser command for Entra ID sign-in"),		 FALSE, NULL,		  N_("Optional. Command used to open the sign-in page, e.g. \"flatpak run com.google.Chrome\". Empty uses the default browser (xdg-open).")											 },
+#endif
 	{ REMMINA_PROTOCOL_SETTING_TYPE_TEXT,	  "clientname",		    N_("Client name"),					 FALSE, NULL,		  NULL														 },
 	{ REMMINA_PROTOCOL_SETTING_TYPE_COMBO,	  "clientbuild",	    N_("Client build"),					 FALSE, clientbuild_list, clientbuild_tooltip												 },
 	{ REMMINA_PROTOCOL_SETTING_TYPE_TEXT,	  "exec",		    N_("Start-up program"),				 FALSE, NULL,		  NULL														 },
diff --git a/plugins/rdp/rdp_web_auth.c b/plugins/rdp/rdp_web_auth.c
index 53cd19af3..bee93d85f 100644
--- a/plugins/rdp/rdp_web_auth.c
+++ b/plugins/rdp/rdp_web_auth.c
@@ -60,6 +60,9 @@ static BOOL remmina_sso_mib_try_access_token(freerdp *instance, AccessTokenType
 #ifdef WITH_RDP_AUTH_AAD
 #include "rdp_plugin.h"
 #include <webkit2/webkit2.h>
+#ifdef WITH_RDP_AAD_HELPER
+#include <freerdp/client/aad_helper.h>
+#endif
 #include <freerdp/utils/aad.h>
 #include <winpr/wtypes.h>
 #include <winpr/wlog.h>
@@ -384,12 +387,74 @@ cleanup:
 	return rc && (*token != NULL);
 }
 
+#ifdef WITH_RDP_AAD_HELPER
+/* Entra ID sign-in through FreeRDP's out-of-process AAD auth helper instead of the embedded
+ * WebKitGTK view. The helper opens the system browser (or its own webview), which supports
+ * passkeys / FIDO2 security keys / phone passkeys; WebKitGTK has no WebAuthn implementation.
+ * One helper instance is kept for the connection so the browser session carries over from the
+ * gateway token to the session-host token (single sign-in). */
+static gboolean remmina_rdp_aad_helper_enabled(freerdp* instance)
+{
+	rfContext* rfi = (rfContext*)instance->context;
+	RemminaFile* remminafile = remmina_plugin_service->protocol_plugin_get_file(rfi->protocol_widget);
+	return remmina_plugin_service->file_get_int(remminafile, "aad_external_browser", FALSE);
+}
+
+static BOOL remmina_rdp_aad_helper_get_access_token(freerdp* instance, AccessTokenType tokenType,
+                                                    char** token, size_t count, va_list ap)
+{
+	rfContext* rfi = (rfContext*)instance->context;
+	rdpClientContext* cctx = &rfi->clientContext;
+	RemminaFile* remminafile = remmina_plugin_service->protocol_plugin_get_file(rfi->protocol_widget);
+
+	/* Optional browser override, honoured by FreeRDP's xdg-open based helper. */
+	const gchar* browser = remmina_plugin_service->file_get_string(remminafile, "aad_browser");
+	if (browser && *browser)
+		g_setenv("FREERDP_AAD_BROWSER", browser, TRUE);
+
+	if (!aad_auth_helper_is_running(cctx->aadHelper)) {
+		aad_auth_helper_stop(cctx->aadHelper);
+		cctx->aadHelper = aad_auth_helper_start(cctx);
+		if (!cctx->aadHelper) {
+			REMMINA_PLUGIN_ERROR("Could not start the FreeRDP AAD auth helper");
+			return FALSE;
+		}
+	}
+
+	const BOOL rc = aad_auth_helper_get_access_token_v(cctx->aadHelper, tokenType, token, count, ap);
+	if (!rc && !aad_auth_helper_is_running(cctx->aadHelper)) {
+		aad_auth_helper_stop(cctx->aadHelper);
+		cctx->aadHelper = NULL;
+	}
+	return rc;
+}
+
+void remmina_rdp_aad_helper_stop(freerdp* instance)
+{
+	if (!instance || !instance->context)
+		return;
+	rfContext* rfi = (rfContext*)instance->context;
+	aad_auth_helper_stop(rfi->clientContext.aadHelper);
+	rfi->clientContext.aadHelper = NULL;
+}
+#endif /* WITH_RDP_AAD_HELPER */
+
 BOOL remmina_rdp_get_access_token(freerdp* instance, AccessTokenType tokenType, char** token,
 									size_t count, ...)
 {
 	const char* scope = NULL;
 	const char* req_cnf = NULL;
 
+#ifdef WITH_RDP_AAD_HELPER
+	if (remmina_rdp_aad_helper_enabled(instance)) {
+		va_list hap = { 0 };
+		va_start(hap, count);
+		const BOOL hrc = remmina_rdp_aad_helper_get_access_token(instance, tokenType, token, count, hap);
+		va_end(hap);
+		return hrc;
+	}
+#endif
+
 	va_list ap = { 0 };
 	va_start(ap, count);
 	if (tokenType == ACCESS_TOKEN_TYPE_AAD)
diff --git a/plugins/rdp/rdp_web_auth.h b/plugins/rdp/rdp_web_auth.h
index 2b0f1dd76..463d68087 100644
--- a/plugins/rdp/rdp_web_auth.h
+++ b/plugins/rdp/rdp_web_auth.h
@@ -39,6 +39,11 @@
 #if FREERDP_VERSION_MAJOR >= 3
 #include <freerdp/freerdp.h>
 
+#ifdef WITH_RDP_AAD_HELPER
+/* Stops the FreeRDP AAD auth helper process kept for this connection, if any. */
+void remmina_rdp_aad_helper_stop(freerdp* instance);
+#endif
+
 BOOL remmina_rdp_get_access_token(freerdp* instance, AccessTokenType tokenType, char** token,
                                     size_t count, ...);
 #endif
