From b6a724ae7cb171558656513549cd8204cb26400d Mon Sep 17 00:00:00 2001
From: Aaron Sowards <asowards@users.noreply.github.com>
Date: Sat, 17 Oct 2026 20:21:18 -0400
Subject: [PATCH 1/3] rdp: optional Entra ID sign-in through FreeRDP's AAD auth
 helper

Entra ID sign-in currently runs in an embedded WebKitGTK view, which has no
WebAuthn implementation, so tenants that require passkeys, FIDO2 security
keys or phone passkeys at sign-in cannot connect to Azure Virtual Desktop
from Remmina.

FreeRDP >= 3.32 exports its out-of-process AAD auth helper
(<freerdp/client/aad_helper.h>), which opens the system browser (or its own
webview) and reports the redirect back; one helper is kept per connection
so the browser session carries over from the gateway token to the
session-host token.

Add two RDP profile settings, compiled only when the helper API is present:
- "aad_external_browser": route GetAccessToken through the FreeRDP helper
  instead of the WebKitGTK view;
- "aad_browser": optional browser command passed to the helper
  (FREERDP_AAD_BROWSER), e.g. a Flatpak Chrome, for tenants whose
  sign-in needs a browser capability the default one lacks.

The helper process is stopped when the connection's FreeRDP instance is
freed.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 plugins/rdp/CMakeLists.txt |  7 ++++
 plugins/rdp/rdp_plugin.c   |  7 ++++
 plugins/rdp/rdp_web_auth.c | 65 ++++++++++++++++++++++++++++++++++++++
 plugins/rdp/rdp_web_auth.h |  5 +++
 4 files changed, 84 insertions(+)

diff --git a/plugins/rdp/CMakeLists.txt b/plugins/rdp/CMakeLists.txt
index e78d9b27b..18c0b7da5 100644
--- a/plugins/rdp/CMakeLists.txt
+++ b/plugins/rdp/CMakeLists.txt
@@ -103,6 +103,13 @@ if(WITH_RDP_AUTH_AAD)
         message(STATUS "Enabling RDP AAD authentication.")
         # we cannot undefine WITH_AAD defined in FreeRDP so we use our own macro
         add_definitions(-DWITH_RDP_AUTH_AAD)
+        # FreeRDP >= 3.32 exports its out-of-process AAD auth helper (system browser or
+        # embedded webview, see <freerdp/client/aad_helper.h>). Unlike the WebKitGTK view it
+        # supports passkeys/WebAuthn at sign-in, which Entra ID increasingly requires.
+        if(EXISTS "${FreeRDP_INCLUDE_DIR}/freerdp/client/aad_helper.h")
+            message(STATUS "FreeRDP AAD auth helper API found, enabling external sign-in option.")
+            add_definitions(-DWITH_RDP_AAD_HELPER)
+        endif()
         include_directories(
             ${WEBKIT2GTK_INCLUDE_DIRS}
             ${LIBSOUP_INCLUDE_DIRS})
diff --git a/plugins/rdp/rdp_plugin.c b/plugins/rdp/rdp_plugin.c
index f928f4042..17c69e603 100644
--- a/plugins/rdp/rdp_plugin.c
+++ b/plugins/rdp/rdp_plugin.c
@@ -2818,6 +2818,9 @@ static void rfi_uninit(rfContext *rfi)
 	}
 
 	if (instance) {
