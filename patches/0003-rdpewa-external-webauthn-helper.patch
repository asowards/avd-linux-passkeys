index 0000000..9887c65
--- /dev/null
+++ b/channels/rdpewa/client/rdpewa_helper.c
@@ -0,0 +1,378 @@
+/**
+ * FreeRDP: A Remote Desktop Protocol Implementation
+ * WebAuthn Virtual Channel Extension [MS-RDPEWA] - external helper backend
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include <freerdp/config.h>
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+
+#include <winpr/crt.h>
+#include <winpr/assert.h>
+#include <winpr/json.h>
+#include <winpr/wlog.h>
+
+#include <freerdp/crypto/crypto.h>
+#include <freerdp/channels/log.h>
+
+#include "rdpewa_helper.h"
+#include <rdpewa-common.h>
+
+#define TAG CHANNELS_TAG("rdpewa.client")
+
+#define RDPEWA_HELPER_MAX_REPLY (4 * 1024 * 1024)
+
+const char* rdpewa_helper_path(void)
+{
+	const char* path = getenv(RDPEWA_HELPER_ENV);
+	if (!path || !*path)
+		return nullptr;
+	return path;
+}
+
+static char* rdpewa_helper_build_request(const RDPEWA_REQUEST* request)
+{
+	WINPR_ASSERT(request);
+	WINPR_ASSERT(request->request);
+	WINPR_ASSERT(request->requestLen >= 1);
+
+	const BYTE subCommand = request->request[0];
+	const char* command = nullptr;
+	switch (subCommand)
+	{
+		case CTAPCBOR_CMD_MAKE_CREDENTIAL:
+			command = "makeCredential";
+			break;
+		case CTAPCBOR_CMD_GET_ASSERTION:
+			command = "getAssertion";
+			break;
+		default:
+			WLog_ERR(TAG, "helper: unknown WebAuthn sub-command 0x%02" PRIx8, subCommand);
+			return nullptr;
+	}
+
+	char* json = nullptr;
+	char* ctap = crypto_base64_encode(request->request + 1, request->requestLen - 1);
+	if (!ctap)
+		return nullptr;
+
+	WINPR_JSON* obj = WINPR_JSON_CreateObject();
+	if (!obj)
+		goto out;
+
+	if (!WINPR_JSON_AddIntegerToObject(obj, "protocol", 1) ||
+	    !WINPR_JSON_AddStringToObject(obj, "command", command) ||
+	    !WINPR_JSON_AddStringToObject(obj, "rpId", request->rpId) ||
+	    !WINPR_JSON_AddStringToObject(obj, "ctapRequest", ctap) ||
+	    !WINPR_JSON_AddIntegerToObject(obj, "flags", request->flags) ||
+	    !WINPR_JSON_AddIntegerToObject(obj, "timeoutMs", request->timeout) ||
+	    !WINPR_JSON_AddBoolToObject(obj, "filterHybrid", request->filterHybrid))
+		goto out;
+
+	json = WINPR_JSON_PrintUnformatted(obj);
+
+out:
+	WINPR_JSON_Delete(obj);
+	free(ctap);
+	return json;
+}
+
+static BOOL rdpewa_helper_write_all(int fd, const char* data, size_t length)
+{
+	size_t written = 0;
+	while (written < length)
+	{
+		const ssize_t rc = write(fd, data + written, length - written);
+		if (rc < 0)
+		{
+			if (errno == EINTR)
+				continue;
+			return FALSE;
+		}
+		written += (size_t)rc;
+	}
+	return TRUE;
+}
+
+/** Runs the helper, feeds it @p requestJson and returns its complete stdout (NUL terminated). */
+static char* rdpewa_helper_exchange(const char* path, const char* requestJson, int* exitStatus)
+{
+	int toChild[2] = { -1, -1 };
+	int fromChild[2] = { -1, -1 };
+	char* reply = nullptr;
+
+	WINPR_ASSERT(exitStatus);
+	*exitStatus = -1;
+
+	if (pipe(toChild) != 0 || pipe(fromChild) != 0)
+	{
+		WLog_ERR(TAG, "helper: pipe() failed: %s", strerror(errno));
+		goto out;
+	}
+
+	const pid_t pid = fork();
+	if (pid < 0)
+	{
+		WLog_ERR(TAG, "helper: fork() failed: %s", strerror(errno));
+		goto out;
+	}
+
+	if (pid == 0)
+	{
+		/* child */
+		if (dup2(toChild[0], STDIN_FILENO) < 0 || dup2(fromChild[1], STDOUT_FILENO) < 0)
+			_exit(126);
+		close(toChild[0]);
+		close(toChild[1]);
+		close(fromChild[0]);
+		close(fromChild[1]);
+		execl(path, path, (char*)nullptr);
+		_exit(127);
+	}
+
+	/* parent */
+	close(toChild[0]);
+	toChild[0] = -1;
+	close(fromChild[1]);
+	fromChild[1] = -1;
+
+	const size_t len = strlen(requestJson);
+	if (!rdpewa_helper_write_all(toChild[1], requestJson, len) ||
+	    !rdpewa_helper_write_all(toChild[1], "\n", 1))
+		WLog_WARN(TAG, "helper: writing request failed: %s", strerror(errno));
+	close(toChild[1]);
+	toChild[1] = -1;
+
+	size_t cap = 4096;
+	size_t used = 0;
+	reply = calloc(cap, 1);
+	if (!reply)
+		goto wait;
+
+	while (TRUE)
+	{
+		if (used + 1 >= cap)
+		{
+			if (cap >= RDPEWA_HELPER_MAX_REPLY)
+			{
+				WLog_ERR(TAG, "helper: reply exceeds %d bytes", RDPEWA_HELPER_MAX_REPLY);
+				free(reply);
+				reply = nullptr;
+				break;
+			}
+			const size_t ncap = cap * 2;
+			char* tmp = realloc(reply, ncap);
+			if (!tmp)
+			{
+				free(reply);
+				reply = nullptr;
+				break;
+			}
+			reply = tmp;
+			memset(reply + cap, 0, ncap - cap);
+			cap = ncap;
+		}
+		const ssize_t rc = read(fromChild[0], reply + used, cap - used - 1);
+		if (rc < 0)
+		{
+			if (errno == EINTR)
+				continue;
+			WLog_ERR(TAG, "helper: read failed: %s", strerror(errno));
+			free(reply);
+			reply = nullptr;
+			break;
+		}
+		if (rc == 0)
+			break;
+		used += (size_t)rc;
+	}
+
+wait:
+	close(fromChild[0]);
+	fromChild[0] = -1;
+	{
+		int status = 0;
+		while (waitpid(pid, &status, 0) < 0)
+		{
+			if (errno != EINTR)
+				break;
+		}
+		if (WIFEXITED(status))
+			*exitStatus = WEXITSTATUS(status);
+		else if (WIFSIGNALED(status))
+			*exitStatus = 128 + WTERMSIG(status);
+	}
+
+out:
+	for (size_t i = 0; i < 2; i++)
+	{
+		if (toChild[i] >= 0)
+			close(toChild[i]);
+		if (fromChild[i] >= 0)
+			close(fromChild[i]);
+	}
+	return reply;
+}
+
+static UINT32 rdpewa_helper_json_uint(const WINPR_JSON* obj, const char* key, UINT32 defaultValue)
+{
+	WINPR_JSON* item = WINPR_JSON_GetObjectItem(obj, key);
+	if (!item || !WINPR_JSON_IsNumber(item))
+		return defaultValue;
+	const double v = WINPR_JSON_GetNumberValue(item);
+	if (v < 0 || v > (double)UINT32_MAX)
+		return defaultValue;
+	return (UINT32)v;
+}
+
+static const char* rdpewa_helper_json_string(const WINPR_JSON* obj, const char* key)
+{
+	WINPR_JSON* item = WINPR_JSON_GetObjectItem(obj, key);
+	if (!item || !WINPR_JSON_IsString(item))
+		return nullptr;
+	return WINPR_JSON_GetStringValue(item);
+}
+
+static void rdpewa_helper_fill_devinfo(RDPEWA_DEVICE_INFO* devInfo, const WINPR_JSON* reply)
+{
+	WINPR_ASSERT(devInfo);
+
+	const char* provider = reply ? rdpewa_helper_json_string(reply, "provider") : nullptr;
+	/* MS-RDPEWA only knows Hid/Nfc/Ble/Platform; hybrid (phone) is closest to Ble */
+	const char* providerType = "Hid";
+	if (provider && (strcmp(provider, "Hybrid") == 0 || strcmp(provider, "Ble") == 0))
+		providerType = "Ble";
+	else if (provider && strcmp(provider, "Nfc") == 0)
+		providerType = "Nfc";
+
+	strncpy(devInfo->providerType, providerType, sizeof(devInfo->providerType) - 1);
+	strncpy(devInfo->providerName, "freerdp-webauthn-helper", sizeof(devInfo->providerName) - 1);
+	strncpy(devInfo->devicePath, provider ? provider : "helper", sizeof(devInfo->devicePath) - 1);
+	strncpy(devInfo->manufacturer, "FreeRDP", sizeof(devInfo->manufacturer) - 1);
+	strncpy(devInfo->product, "WebAuthn helper", sizeof(devInfo->product) - 1);
+	devInfo->maxMsgSize = 1200;
+	if (reply)
+	{
+		devInfo->uvStatus = (BYTE)rdpewa_helper_json_uint(reply, "uvStatus", 0);
+		devInfo->transports = rdpewa_helper_json_uint(reply, "transports", 0);
+	}
+}
+
+wStream* rdpewa_helper_webauthn(rdpContext* context, const RDPEWA_REQUEST* request)
+{
+	WINPR_UNUSED(context);
+	WINPR_ASSERT(request);
+
+	const char* path = rdpewa_helper_path();
+	if (!path)
+		return nullptr;
+
+	if (!request->request || request->requestLen < 1)
+	{
+		WLog_ERR(TAG, "helper: empty request payload for WEB_AUTHN command");
+		return nullptr;
+	}
+
+	wStream* ret = nullptr;
+	WINPR_JSON* reply = nullptr;
+	BYTE* ctapData = nullptr;
+	size_t ctapLen = 0;
+	RDPEWA_DEVICE_INFO devInfo = WINPR_C_ARRAY_INIT;
+
+	char* requestJson = rdpewa_helper_build_request(request);
+	if (!requestJson)
+		return nullptr;
+
+	WLog_DBG(TAG, "helper: running %s (rpId=%s, %" PRIuz " request bytes)", path, request->rpId,
+	         request->requestLen);
+
+	int exitStatus = -1;
+	char* replyText = rdpewa_helper_exchange(path, requestJson, &exitStatus);
+	free(requestJson);
+
+	if (!replyText)
+	{
+		WLog_ERR(TAG, "helper: no reply from %s (exit status %d)", path, exitStatus);
+		return nullptr; /* infrastructure failure: let the caller fall back */
+	}
+
+	/* The reply is the last non-empty line (helpers may log before it on stdout by mistake). */
+	char* line = replyText;
+	for (char* p = strrchr(replyText, '\n'); p; p = strrchr(replyText, '\n'))
+	{
+		*p = '\0';
+		if (p[1] != '\0')
+		{
+			line = p + 1;
+			break;
+		}
+	}
+
+	reply = WINPR_JSON_Parse(line);
+	if (!reply)
+	{
+		WLog_ERR(TAG, "helper: reply is not valid JSON (exit status %d)", exitStatus);
+		free(replyText);
+		return nullptr;
+	}
+
+	rdpewa_helper_fill_devinfo(&devInfo, reply);
+
+	const char* status = rdpewa_helper_json_string(reply, "status");
+	if (!status || strcmp(status, "ok") != 0)
+	{
+		const char* message = rdpewa_helper_json_string(reply, "message");
+		const UINT32 ctapStatus = rdpewa_helper_json_uint(reply, "ctapStatus", 0x01);
+		const UINT32 hresult = rdpewa_helper_json_uint(reply, "hresult", (UINT32)E_FAIL);
+		WLog_WARN(TAG, "helper: operation failed: %s (ctapStatus=0x%02" PRIx32
+		          ", hresult=0x%08" PRIx32 ", exit=%d)",
+		          message ? message : "unknown", ctapStatus, hresult, exitStatus);
+		ret = rdpewa_cbor_encode_webauthn_response((HRESULT)hresult, (BYTE)ctapStatus, nullptr, 0,
+		                                           &devInfo);
+		goto out;
+	}
+
+	const char* ctapB64 = rdpewa_helper_json_string(reply, "ctapResponse");
+	if (!ctapB64)
+	{
+		WLog_ERR(TAG, "helper: ok reply without ctapResponse");
+		ret = rdpewa_cbor_encode_webauthn_response(E_FAIL, 0x01, nullptr, 0, &devInfo);
+		goto out;
+	}
+
+	crypto_base64_decode(ctapB64, strlen(ctapB64), &ctapData, &ctapLen);
+	if (!ctapData || ctapLen == 0)
+	{
+		WLog_ERR(TAG, "helper: ctapResponse is not valid base64");
+		ret = rdpewa_cbor_encode_webauthn_response(E_FAIL, 0x01, nullptr, 0, &devInfo);
+		goto out;
+	}
+
+	WLog_DBG(TAG, "helper: success, %" PRIuz " CTAP response bytes via %s", ctapLen,
+	         devInfo.providerType);
+	ret = rdpewa_cbor_encode_webauthn_response(S_OK, 0x00, ctapData, ctapLen, &devInfo);
+
+out:
+	free(ctapData);
+	WINPR_JSON_Delete(reply);
+	free(replyText);
+	return ret;
+}
