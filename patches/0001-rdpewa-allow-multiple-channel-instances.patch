From: FreeRDP PR #13757 (himamaheswarreddy) -- non-test hunks only
Subject: [rdpewa] allow multiple WebAuthn channel instances

Upstream: https://github.com/FreeRDP/FreeRDP/pull/13757 (fixes #13741).
AVD/W365 session hosts reopen the WebAuthn DVC before closing the previous
instance; the generic DVC guard added in 3.32 rejected the second open with
ERROR_DEVICE_ALREADY_ATTACHED. This adds a per-plugin opt-in and enables it
for rdpewa only. Drop this patch once upstream merges its final version.

diff --git a/channels/client/generic_dynvc.c b/channels/client/generic_dynvc.c
index ecb60bee0047..361c964b7bfe 100644
--- a/channels/client/generic_dynvc.c
+++ b/channels/client/generic_dynvc.c
@@ -55,7 +55,8 @@ static UINT generic_on_close(IWTSVirtualChannelCallback* pChannelCallback)
 	WINPR_ASSERT(plugin->channel_callbacks);
 	const UINT rc =
 	    IFCALLRESULT(CHANNEL_RC_OK, plugin->channel_callbacks->OnClose, pChannelCallback);
-	generic_update_connected_state(plugin, FALSE);
+	if (!plugin->allowMultipleInstances)
+		generic_update_connected_state(plugin, FALSE);
 
 	return rc;
 }
@@ -74,7 +75,7 @@ static UINT generic_on_new_channel_connection(IWTSListenerCallback* pListenerCal
 	GENERIC_DYNVC_PLUGIN* plugin = (GENERIC_DYNVC_PLUGIN*)listener_callback->plugin;
 	WLog_Print(plugin->log, WLOG_TRACE, "...");
 
-	if (generic_get_connected_state(plugin))
+	if (!plugin->allowMultipleInstances && generic_get_connected_state(plugin))
 	{
 		WLog_Print(plugin->log, WLOG_ERROR, "Channel already connected, terminating.");
 		return ERROR_DEVICE_ALREADY_ATTACHED;
@@ -100,7 +101,8 @@ static UINT generic_on_new_channel_connection(IWTSListenerCallback* pListenerCal
 	listener_callback->channel = pChannel;
 
 	*ppCallback = &callback->iface;
-	generic_update_connected_state(plugin, TRUE);
+	if (!plugin->allowMultipleInstances)
+		generic_update_connected_state(plugin, TRUE);
 	return CHANNEL_RC_OK;
 }
 
diff --git a/channels/rdpewa/client/rdpewa_main.c b/channels/rdpewa/client/rdpewa_main.c
index 01ac09b76378..def0008dfeb6 100644
--- a/channels/rdpewa/client/rdpewa_main.c
+++ b/channels/rdpewa/client/rdpewa_main.c
@@ -254,6 +254,7 @@ static UINT rdpewa_init_plugin_cb(GENERIC_DYNVC_PLUGIN* base, rdpContext* rconte
 	WINPR_UNUSED(settings);
 
 	RDPEWA_PLUGIN* rdpewa = (RDPEWA_PLUGIN*)base;
+	base->allowMultipleInstances = TRUE;
 	rdpewa->rdp_context = rcontext;
 	return CHANNEL_RC_OK;
 }
diff --git a/include/freerdp/client/channels.h b/include/freerdp/client/channels.h
index e27ce43d0a89..1f9c9304a724 100644
--- a/include/freerdp/client/channels.h
+++ b/include/freerdp/client/channels.h
@@ -65,6 +65,8 @@ extern "C"
 		size_t channelCallbackSize;
 		const IWTSVirtualChannelCallback* channel_callbacks;
 		DYNVC_PLUGIN_TERMINATE_FN terminatePluginFn;
+		/* Some dynamic channels, such as RDPEWA, support multiple instances. */
+		BOOL allowMultipleInstances;
 	};
 
 #if defined(WITH_CHANNELS)
